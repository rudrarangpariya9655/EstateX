# ─────────────────────────────────────────────────────────────────────────────
# EstateX environment configuration
# Copy to `.env.local` and fill in the values you have. Every integration is
# optional in development: without Supabase the app runs in "demo mode" with a
# local JSON database in `.data/`. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the site (used for canonical URLs, sitemaps, OG tags and
# auth email redirects). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (database + authentication) ─────────────────────────────────────
# Project Settings → API. When both are set, EstateX uses Supabase for all data
# and auth. Run supabase/migrations/*.sql and supabase/seed.sql first.
NEXT_PUBLIC_SUPABASE_URL=
# Either the new publishable key (sb_publishable_…) or the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Cloudinary (admin image uploads) ─────────────────────────────────────────
# Optional. If unset, uploads go to Supabase Storage (bucket `property-images`)
# when Supabase is configured, otherwise to `.data/uploads` in demo mode.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=estatex

# ── Maps ─────────────────────────────────────────────────────────────────────
# Optional. Without a token the map uses CARTO's free light basemap (OSM data).
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Demo mode only (no Supabase) ─────────────────────────────────────────────
# Comma-separated emails that receive the admin role when they create an
# account in demo mode. With Supabase, promote admins in SQL instead
# (see README → "Creating an admin").
ESTATEX_ADMIN_EMAILS=
# Secret used to sign demo-mode session cookies. Required for `next start`
# in demo mode; generated automatically in development if left empty.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ESTATEX_AUTH_SECRET=
# Where the demo database and uploads live (defaults to ./.data).
# ESTATEX_DATA_DIR=
